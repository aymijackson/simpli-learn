# -----------------------------------------------------------------------------
# PRODUCTION (live server) — change these from the development defaults below:
#   APP_ENV=production
#   APP_DEBUG=false
#   APP_URL=https://your-domain            (serve over HTTPS)
#   SESSION_ENCRYPT=true
#   SESSION_SECURE_COOKIE=true
#   MAIL_MAILER=smtp  + MAIL_HOST / MAIL_PORT / MAIL_USERNAME / MAIL_PASSWORD /
#   MAIL_SCHEME=smtps (port 465) and MAIL_FROM_ADDRESS from a real mailbox,
#   e.g. a cPanel email account (cPanel > Email Accounts > Connect Devices).
# deploy/deploy-assets.sh warns if any of these are still unsafe.
# -----------------------------------------------------------------------------
APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Document root that deploy/deploy-assets.sh copies public assets into.
# Relative paths resolve from the app folder.
DEPLOY_PUBLIC_DIR=../simpli-learn.hitmoh.com

# Workspace owners and platform admins must turn on two-step login before
# using the back office. Set to false to make it optional for everyone.
REQUIRE_TWO_FACTOR=true

# Content-Security-Policy is report-only (violations go to storage/logs/csp.log).
# Set to true once that log stays empty under normal use.
CSP_ENFORCE=false
# Where the "public" disk stores uploads. Set on hosts without symlink
# support (no storage:link); relative paths resolve from the app folder.
PUBLIC_DISK_ROOT=
